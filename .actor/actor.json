{
    "actorSpecification": 1,
    "name": "sift-stack",
    "title": "SiftStack — TX REI Operations Platform",
    "description": "REI pipeline for Travis/Bell/Williamson TX — scrapes foreclosures, probate, tax-sale, and Travis tax-delinquent. Runs Smarty + Zillow + obituary/deceased-owner detection, detects sold/paid-off properties via cross-run diff, outputs DataSift CSVs + deep-prospecting PDFs.",
    "version": "1.1",
    "buildTag": "latest",
    "input": "./input_schema.json",
    "dockerfile": "../Dockerfile",
    "minMemoryMbytes": 2048,
    "maxMemoryMbytes": 4096,
    "defaultRunOptions": {
        "memoryMbytes": 2048,
        "timeoutSecs": 3600
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "SiftStack Records",
            "views": {
                "overview": {
                    "title": "Overview",
                    "transformation": {
                        "fields": [
                            "date_added",
                            "address",
                            "city",
                            "state",
                            "zip",
                            "owner_name",
                            "notice_type",
                            "county",
                            "mls_status",
                            "estimated_value",
                            "estimated_equity",
                            "property_type",
                            "source_url"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "date_added": { "label": "Date", "format": "text" },
                            "address": { "label": "Address", "format": "text" },
                            "city": { "label": "City", "format": "text" },
                            "owner_name": { "label": "Owner", "format": "text" },
                            "notice_type": { "label": "Type", "format": "text" },
                            "county": { "label": "County", "format": "text" },
                            "mls_status": { "label": "MLS Status", "format": "text" },
                            "estimated_value": { "label": "Zestimate", "format": "text" },
                            "estimated_equity": { "label": "Est. Equity", "format": "text" },
                            "property_type": { "label": "Prop Type", "format": "text" }
                        }
                    }
                }
            }
        }
    }
}
