# ── SiftStack — Texas REI Operations ───────────────────────────────
# No login credentials needed — all TX data sources are public.

# ── CRM Integration ────────────────────────────────────────────────
# DataSift.ai (formerly REISift) — automated upload + enrich + skip trace
DATASIFT_EMAIL=your_datasift_email@example.com
DATASIFT_PASSWORD=your_datasift_password_here

# ── Enrichment API Keys ────────────────────────────────────────────
# Smarty (address standardization, USPS validation, geocoding)
# Sign up at https://smarty.com — free tier: 250 lookups/month
SMARTY_AUTH_ID=your_smarty_auth_id
SMARTY_AUTH_TOKEN=your_smarty_auth_token

# OpenWeb Ninja (Zillow property data — Zestimate, MLS, equity)
# Sign up at https://openwebninja.com — free tier: 100 requests/month
OPENWEBNINJA_API_KEY=your_openwebninja_api_key

# Anthropic (Claude Haiku — LLM parsing, obituary search, entity research)
# Sign up at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Serper.dev (Google Search — DM address lookup)
# Sign up at https://serper.dev — free tier: 2,500 queries
SERPER_API_KEY=your_serper_api_key

# Firecrawl (JS-rendered page scraping — DM address extraction)
# Sign up at https://firecrawl.dev — free tier: 500 pages
FIRECRAWL_API_KEY=fc-your-key-here

# ── Skip Trace & Phone Validation ──────────────────────────────────
# Tracerfy (batch skip trace — phones, emails, mailing addresses)
# $0.02/record — sign up at https://tracerfy.com
TRACERFY_API_KEY=your_tracerfy_api_key

# Trestle (phone scoring — 5-tier dial priority)
# $0.015/phone — sign up at https://trestleiq.com
TRESTLE_API_KEY=your_trestle_api_key
# Litigator risk check rides on EVERY Trestle query by default. Set to 0 to
# disable globally (per-run: --no-litigator).
TRESTLE_ADD_LITIGATOR=1
# Trestle bills the litigator add-on on top of the base query but does not
# publish the rate. Set your contracted per-phone add-on price here so cost
# estimates include it; left unset, estimates flag it as an unpriced extra.
# TRESTLE_LITIGATOR_COST=0.01

# Enformion / Endato (deep-prospecting-v4 API heir resolution — Person Search)
# ~$2.30-3.00/record — from Enformion Console → API access profile
ENFORMION_AP_NAME=your_enformion_ap_name
ENFORMION_AP_PASSWORD=your_enformion_ap_password

# ── Notifications ──────────────────────────────────────────────────
# Slack or Discord webhook for daily run summaries + error alerts
# Discord: use /slack suffix: https://discord.com/api/webhooks/{id}/{token}/slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Dropbox Auto-Polling (courthouse photo import) ─────────────────
# Create a Dropbox app at https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=your_app_key
DROPBOX_APP_SECRET=your_app_secret
DROPBOX_REFRESH_TOKEN=your_refresh_token
DROPBOX_POLL_INTERVAL=900
DROPBOX_ROOT_FOLDER=TX Courthouse Photos

# ── LLM Backend (optional — defaults to Anthropic) ─────────────────
# Switch to local Ollama or OpenRouter for cheaper/free LLM calls
LLM_BACKEND=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001          # default model for all LLM calls
# Higher-quality model for the accuracy-critical obituary identity + heir/survivor
# extraction (a wrong heir map sends the whole deal down the wrong path).
# OBITUARY_LLM_MODEL=claude-sonnet-4-6
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1/
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# ── Google Drive (optional — CSV backup + DataSift manual-upload staging) ──
GOOGLE_DRIVE_FOLDER_ID=your_folder_id                 # lead CSVs → 00_Inbox
GOOGLE_DRIVE_REPORTS_FOLDER_ID=your_reports_folder_id # deep-prospecting PDFs → 05_Deep-Prospecting-Reports (optional; falls back to GOOGLE_DRIVE_FOLDER_ID)
GOOGLE_DRIVE_CLEANUP_FOLDER_ID=your_cleanup_folder_id # drop-off cleanup CSV (Sold + Code Violation Resolved) → 03_Sold-Cleanup (optional; falls back to GOOGLE_DRIVE_FOLDER_ID/03_Sold-Cleanup). Set to the real 03_Sold-Cleanup folder ID for exact placement (it's a sibling of 00_Inbox, unreachable from the daily folder)
GOOGLE_DRIVE_FORENSICS_FOLDER_ID=your_forensics_folder_id # cross-run diff JSON reports → 04_Forensics-&-Audit (optional; falls back to GOOGLE_DRIVE_FOLDER_ID/04_Forensics-&-Audit)
GOOGLE_DRIVE_AUTO_FOLDER=false                        # true → sort uploads into Year/MM-Month/County/Type (e.g. 2026/07-July/Travis/probate/)
DATASIFT_SPLIT_BY_COUNTY=false                        # true → one lead CSV per county+type (per-county tracking); DataSift list names stay per-type
GOOGLE_SERVICE_ACCOUNT_KEY=base64_encoded_json_key

# ── Ancestry.com (optional — SSDI + obituary collection) ───────────
# Requires World Explorer subscription ($29/month)
# ANCESTRY_EMAIL=your_email@example.com
# ANCESTRY_PASSWORD=your_password

# ── SmartSkip (deep prospecting v5 heir engine) ────────────────────
# Bulk skip trace: returns an owner's relatives WITH phone numbers in one batch.
# NOTE: bulk skip bills the SAVED CARD, not the wallet balance.
# SMARTSKIP_EMAIL=your_email@example.com
# SMARTSKIP_PASSWORD=your_password

# ── DirectSkip (single-record skip-trace API + portal fallback) ────
# API auth = api_key in the request body; your PUBLIC IP must be allowlisted by
# emailing support@directskip.com (account email + public IP). Pay-per-hit:
# a no-match bills nothing. Portal login is the batch fallback (cookie auth).
# DIRECTSKIP_API_KEY=your_api_key
# DIRECTSKIP_EMAIL=your_email@example.com
# DIRECTSKIP_PASSWORD=your_password

# ── Enformion / Endato (ENTITY owners only — BusinessV2) ───────────
# Person Search is retired (see src/smartskip.py); BusinessV2 resolves LLC/trust
# principals, which SmartSkip cannot trace (it requires a first and last name).
# ENFORMION_AP_NAME=your_ap_name
# ENFORMION_AP_PASSWORD=your_ap_password

# ── SmrtPhone dialer (call coaching + MMS) ─────────────────────────
# Session is cookie-based — run `python src/smrtphone.py login` (headed) to mint
# smrtphone_state.json. This var is only used to label the login prompt.
# SMRTPHONE_EMAIL=your_dialer_login@example.com

# ── OpenRouter (call transcription ONLY) ───────────────────────────
# Anthropic models cannot accept audio, and the coaching rubrics score TONALITY,
# so transcription uses an audio-native model via OpenRouter (~$0.002/audio min).
# Everything else in the pipeline stays on Anthropic.
# OPENROUTER_API_KEY=sk-or-...
# CALL_AUDIO_MODEL=google/gemini-2.5-flash

# ── Scraper debugging / run-health (build 1.2.x) ───────────────────
# Headed-vs-headless overrides for the browser scrapers. All default HEADED
# (the anti-bot on these portals blocks old-headless Chromium). Set =1 only
# for debugging; expect 0 results from the affected scraper.
# TCC_HEADLESS=1                       # Travis tccsearch (foreclosure/probate/lien/lis pendens)
# LIEN_PUBLICSEARCH_HEADLESS=1         # Bell lien (GovOS publicsearch)
# LIS_PENDENS_PUBLICSEARCH_HEADLESS=1  # Bell lis pendens (GovOS publicsearch)
# LIEN_TYLER_HEADLESS=1                # Williamson lien (Tyler Self-Service)
# LIS_PENDENS_TYLER_HEADLESS=1         # Williamson lis pendens (Tyler Self-Service)

# Alert-system drill: force one scraper to raise so you can verify the
# run-health Slack alert fires. Format county/type, e.g. bell/lien.
# FORCE_SCRAPER_FAIL=bell/lien

# When set, scrapers dump raw page HTML + innerText here on parse-zero or
# failure (evidence for parser fixes). scraper_smoke.py sets it per target.
# SIFT_DEBUG_CAPTURE_DIR=output/debug_captures

# NOTE — CLI vs Actor dispatch gotcha: python src/main.py runs the APIFY
# Actor path whenever APIFY_TOKEN (or APIFY_IS_AT_HOME) is set — including
# from this .env. To run CLI subcommands locally: APIFY_TOKEN= python src/main.py ...
